<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_lock_discount" model="pos.action.lock.type">
        <field name="name">Remise (globale et par ligne)</field>
        <field name="code">discount</field>
        <field name="sequence">10</field>
    </record>

    <record id="action_lock_refund" model="pos.action.lock.type">
        <field name="name">Remboursement</field>
        <field name="code">refund</field>
        <field name="sequence">20</field>
    </record>

    <record id="action_lock_cancel" model="pos.action.lock.type">
        <field name="name">Annuler la commande</field>
        <field name="code">cancel</field>
        <field name="sequence">30</field>
    </record>

    <record id="action_lock_price" model="pos.action.lock.type">
        <field name="name">Modifier le prix (ligne)</field>
        <field name="code">price</field>
        <field name="sequence">40</field>
    </record>

    <record id="action_lock_line_delete" model="pos.action.lock.type">
        <field name="name">Supprimer une ligne</field>
        <field name="code">line_delete</field>
        <field name="sequence">50</field>
    </record>
</odoo>