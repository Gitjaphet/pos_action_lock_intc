<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_action_lock_intc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="inside">
                <setting string="Protéger les actions sensibles"
                         help="Demande un mot de passe avant d'exécuter les actions cochées.">
                    <field name="pos_intc_lock_actions"/>
                    <div class="content-group mt16" invisible="not pos_intc_lock_actions">
                        <div class="row">
                            <label string="Actions protégées"
                                   for="pos_intc_lock_type_ids"
                                   class="col-lg-3 o_light_label"/>
                            <field name="pos_intc_lock_type_ids"
                                   widget="many2many_checkboxes"
                                   nolabel="1"/>
                        </div>
                        <div class="row mt16">
                            <label string="Mode de déverrouillage"
                                   for="pos_intc_lock_mode"
                                   class="col-lg-3 o_light_label"/>
                            <field name="pos_intc_lock_mode"/>
                        </div>
                        <div class="row" invisible="pos_intc_lock_mode != 'user'">
                            <label string="Utilisateur autorisé"
                                   for="pos_intc_lock_user_id"
                                   class="col-lg-3 o_light_label"/>
                            <field name="pos_intc_lock_user_id"
                                   options="{'no_create': True}"
                                   required="pos_intc_lock_actions and pos_intc_lock_mode == 'user'"/>
                        </div>
                        <div class="row" invisible="pos_intc_lock_mode != 'password'">
                            <label string="Mot de passe"
                                   for="pos_intc_lock_password"
                                   class="col-lg-3 o_light_label"/>
                            <field name="pos_intc_lock_password"
                                   password="True"
                                   placeholder="Laisser vide pour conserver le mot de passe actuel"/>
                        </div>
                    </div>
                </setting>

                <setting string="Restreindre le bouton Paiement"
                         help="Le bouton Paiement est masqué au PdV pour les employés sélectionnés.">
                    <div class="content-group">
                        <div class="row">
                            <label string="Employés sans accès au paiement"
                                   for="pos_intc_no_payment_employee_ids"
                                   class="col-lg-3 o_light_label"/>
                            <field name="pos_intc_no_payment_employee_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   nolabel="1"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>